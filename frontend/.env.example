# Copy to `.env` for local overrides, or set this in your host's dashboard
# (Vercel / Netlify / Render → Environment Variables) before the build runs.
#
# Leave it unset locally and the app falls back to http://localhost:8000.
# In production this MUST be https:// — a page served over https cannot fetch
# an http:// endpoint; the browser blocks it as mixed content.
VITE_API_URL=https://your-backend-host.example.com
